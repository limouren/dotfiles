{
  lib,
  stdenvNoCC,
  fetchurl,
  versionCheckHook,
}:

let
  # Generated by ./update.sh. Do not edit by hand.
  release = lib.importJSON ./hashes.json;
  inherit (release) version;

  system = stdenvNoCC.hostPlatform.system;
  asset = release.assets.${system} or (throw "herdr-core-bin: unsupported system ${system}");
in

stdenvNoCC.mkDerivation {
  pname = "herdr-core-bin";
  inherit version;

  src = fetchurl {
    url = "https://releases.herdr.dev/core/${version}/herdr-core-${asset.name}.tar.gz";
    inherit (asset) hash;
  };

  # The archive has no top-level directory.
  sourceRoot = ".";
  dontBuild = true;

  # On macOS, the core runs from the signed Herdr Core.app, so that macOS can
  # grant local network and microphone access to it. The upstream installer also
  # links the commands to the executable in the bundle.
  installPhase = ''
    runHook preInstall
  ''
  + (
    if stdenvNoCC.hostPlatform.isDarwin then
      ''
        mkdir -p $out/Applications $out/bin
        cp -R "Herdr Core.app" $out/Applications/
        ln -s "$out/Applications/Herdr Core.app/Contents/MacOS/herdr-core" $out/bin/herdr-core
      ''
    else
      ''
        install -Dm755 herdr-core $out/bin/herdr-core
      ''
  )
  + ''
    ln -s herdr-core $out/bin/hc
    runHook postInstall
  '';

  # Stripping changes the signed executable and breaks its signature.
  dontStrip = stdenvNoCC.hostPlatform.isDarwin;

  doInstallCheck = !stdenvNoCC.hostPlatform.isDarwin;
  nativeInstallCheckInputs = [ versionCheckHook ];

  meta = {
    description = "Terminals for coding agents (upstream release binary)";
    homepage = "https://herdr.dev/core";
    changelog = "https://github.com/herdrdev/herdr-core/blob/master/CHANGELOG.md";
    license = lib.licenses.asl20;
    mainProgram = "hc";
    platforms = builtins.attrNames release.assets;
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
  };
}
